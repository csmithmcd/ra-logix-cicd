pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        booleanParam(
            name: 'RUN_PYTHON_ECHO_SMOKE',
            defaultValue: false,
            description: 'Run the read-only FactoryTalk Logix Echo Python connectivity smoke test.'
        )
    }

    environment {
        SOLUTION_DIR = '2-cicd-config\\1-ci-teststage\\2-ci-unittestscript'
        SOLUTION_FILE = 'LogixUnitTesting.sln'
        PYTHON_EXE = 'C:\\Program Files\\Python312\\python.exe'
        ECHO_SDK_WHEEL = 'C:\\Users\\Public\\Documents\\FactoryTalk Logix Echo\\SDK\\Python\\ftecho_sdk-4.0.0-py3-none-any.whl'
    }

    stages {
        stage('Environment') {
            steps {
                bat '''
                    echo Workspace: %WORKSPACE%
                    whoami
                    where git
                    git --version
                    where dotnet
                    dotnet --info
                    dotnet --list-sdks
                '''
            }
        }

        stage('Repository Status') {
            steps {
                bat '''
                    git status
                    git branch --show-current
                    git log -1 --oneline
                '''
            }
        }

        stage('NuGet Sources') {
            steps {
  		bat '''
                    type "%WORKSPACE%\\NuGet.Config"
                    dotnet nuget list source --configfile "%WORKSPACE%\\NuGet.Config"
                    if not exist "C:\\data\\nuget\\rockwell" exit /b 1
                    dir "C:\\data\\nuget\\rockwell\\*.nupkg"
                '''
            }
        }

        stage('Restore') {
            steps {
                dir("${env.SOLUTION_DIR}") {
                    bat 'dotnet restore "%SOLUTION_FILE%" --force --configfile "%WORKSPACE%\\NuGet.Config"'
                }
            }
        }

        stage('Build') {
            steps {
                dir("${env.SOLUTION_DIR}") {
                    bat 'dotnet build "%SOLUTION_FILE%" -c Release --no-restore'
                }
            }
        }

        stage('Verify Output') {
            steps {
                bat '''
                    if not exist "%SOLUTION_DIR%\\UnitTesting_ConsoleApp\\bin\\Release\\net10.0-windows7.0\\UnitTesting_ConsoleApp.dll" exit /b 1
                '''
            }
        }

        stage('Python Echo Setup') {
            options {
                timeout(time: 10, unit: 'MINUTES')
            }
            when {
                expression { params.RUN_PYTHON_ECHO_SMOKE }
            }
            steps {
                bat '''
                    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%WORKSPACE%\\python\\scripts\\setup_venv.ps1" -PythonExecutable "%PYTHON_EXE%" -EchoSdkWheel "%ECHO_SDK_WHEEL%" -VenvPath "%WORKSPACE%\\.venv"
                '''
            }
        }

        stage('Python Echo Read-Only Smoke') {
            when {
                expression { params.RUN_PYTHON_ECHO_SMOKE }
            }
            steps {
                bat '''
                    "%WORKSPACE%\\.venv\\Scripts\\python.exe" "%WORKSPACE%\\python\\smoke\\echo_connectivity.py" --output "%WORKSPACE%\\python\\artifacts\\echo-connectivity.json" --timeout-seconds 30
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: '2-cicd-config/1-ci-teststage/2-ci-unittestscript/**/bin/Release/**/*,python/artifacts/*.json',
                             allowEmptyArchive: true,
                             fingerprint: true
        }

        success {
            echo 'Jenkins smoke pipeline completed successfully.'
        }

        failure {
            echo 'Jenkins smoke pipeline failed. Review the first failing stage.'
        }
    }
}
