pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        booleanParam(
            name: 'RUN_PYTHON_ECHO_SMOKE',
            defaultValue: false,
            description: 'Run the read-only FactoryTalk Logix Echo Python connectivity smoke test.'
        )
        booleanParam(
            name: 'RUN_PYTHON_LOGIX_DESIGNER_SMOKE',
            defaultValue: false,
            description: 'Run the read-only Logix Designer Python open/close probe. Disabled by default.'
        )
        string(
            name: 'LOGIX_DESIGNER_PYTHON_EXE',
            defaultValue: 'C:\\Program Files\\Python313\\python.exe',
            description: 'Python 3.13 x64 executable for Logix Designer smoke stages.'
        )
        booleanParam(
            name: 'RUN_PYTHON_LOGIX_DESIGNER_EXECUTABLE_ENUMERATION',
            defaultValue: false,
            description: 'Read executable metadata from a disposable ACD copy. Keep disabled until manually validated.'
        )
        booleanParam(
            name: 'RUN_PYTHON_LOGIX_DESIGNER_PROJECT_INVENTORY',
            defaultValue: false,
            description: 'Read project communications path and executable inventory from a disposable ACD copy. Keep disabled until manually validated.'
        )
    }

    environment {
        SOLUTION_DIR = '2-cicd-config\\1-ci-teststage\\2-ci-unittestscript'
        SOLUTION_FILE = 'LogixUnitTesting.sln'
        PYTHON_EXE = 'C:\\Program Files\\Python313\\python.exe'
        ECHO_SDK_WHEEL = 'C:\\Users\\Public\\Documents\\FactoryTalk Logix Echo\\SDK\\Python\\ftecho_sdk-4.0.0-py3-none-any.whl'
        LOGIX_DESIGNER_SDK_WHEEL = 'C:\\Users\\Public\\Documents\\Studio 5000\\Logix Designer SDK\\python\\logix_designer_sdk-2.0.2-py3-none-any.whl'
        LOGIX_DESIGNER_PROJECT = '1-production-files\\ACDs\\ExampleForCICD_L85E.ACD'
    }

    stages {
        stage('Environment') {
            steps {
                bat '''
                    echo Workspace: %WORKSPACE%
                    whoami
                    where git
                    git --version
                    where dotnet
                    dotnet --info
                    dotnet --list-sdks
                '''
            }
        }

        stage('Repository Status') {
            steps {
                bat '''
                    git status
                    git branch --show-current
                    git log -1 --oneline
                '''
            }
        }

        stage('NuGet Sources') {
            steps {
  		bat '''
                    type "%WORKSPACE%\\NuGet.Config"
                    dotnet nuget list source --configfile "%WORKSPACE%\\NuGet.Config"
                    if not exist "C:\\data\\nuget\\rockwell" exit /b 1
                    dir "C:\\data\\nuget\\rockwell\\*.nupkg"
                '''
            }
        }

        stage('Restore') {
            steps {
                dir("${env.SOLUTION_DIR}") {
                    bat 'dotnet restore "%SOLUTION_FILE%" --force --configfile "%WORKSPACE%\\NuGet.Config"'
                }
            }
        }

        stage('Build') {
            steps {
                dir("${env.SOLUTION_DIR}") {
                    bat 'dotnet build "%SOLUTION_FILE%" -c Release --no-restore'
                }
            }
        }

        stage('Verify Output') {
            steps {
                bat '''
                    if not exist "%SOLUTION_DIR%\\UnitTesting_ConsoleApp\\bin\\Release\\net10.0-windows7.0\\UnitTesting_ConsoleApp.dll" exit /b 1
                '''
            }
        }

        stage('Python Echo Setup') {
            options {
                timeout(time: 10, unit: 'MINUTES')
            }
            when {
                expression { params.RUN_PYTHON_ECHO_SMOKE }
            }
            steps {
                bat '''
                    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%WORKSPACE%\\python\\scripts\\setup_venv.ps1" -PythonExecutable "%PYTHON_EXE%" -EchoSdkWheel "%ECHO_SDK_WHEEL%" -VenvPath "%WORKSPACE%\\.venv"
                '''
            }
        }

        stage('Python Echo Read-Only Smoke') {
            when {
                expression { params.RUN_PYTHON_ECHO_SMOKE }
            }
            steps {
                bat '''
                    "%WORKSPACE%\\.venv\\Scripts\\python.exe" "%WORKSPACE%\\python\\smoke\\echo_connectivity.py" --output "%WORKSPACE%\\python\\artifacts\\echo-connectivity.json" --timeout-seconds 30
                '''
            }
        }

        stage('Python Logix Designer Setup') {
            options {
                timeout(time: 10, unit: 'MINUTES')
            }
            when {
                expression {
                    params.RUN_PYTHON_LOGIX_DESIGNER_SMOKE ||
                    params.RUN_PYTHON_LOGIX_DESIGNER_EXECUTABLE_ENUMERATION ||
                    params.RUN_PYTHON_LOGIX_DESIGNER_PROJECT_INVENTORY
                }
            }
            steps {
                bat '''
                    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%WORKSPACE%\\python\\scripts\\setup_logix_designer_venv.ps1" -PythonExecutable "%LOGIX_DESIGNER_PYTHON_EXE%" -LogixDesignerSdkWheel "%LOGIX_DESIGNER_SDK_WHEEL%" -VenvPath "%WORKSPACE%\\.venv-logix-designer"
                '''
            }
        }

        stage('Python Logix Designer Read-Only Smoke') {
            options {
                timeout(time: 12, unit: 'MINUTES')
            }
            when {
                expression { params.RUN_PYTHON_LOGIX_DESIGNER_SMOKE }
            }
            steps {
                bat '''
                    "%WORKSPACE%\\.venv-logix-designer\\Scripts\\python.exe" "%WORKSPACE%\\python\\smoke\\logix_designer_executables.py" --project "%WORKSPACE%\\%LOGIX_DESIGNER_PROJECT%" --output "%WORKSPACE%\\python\\artifacts\\logix-designer-open-project.json" --timeout-seconds 600
                '''
            }
        }

        stage('Python Logix Designer Executable Enumeration') {
            options {
                timeout(time: 12, unit: 'MINUTES')
            }
            when {
                expression { params.RUN_PYTHON_LOGIX_DESIGNER_EXECUTABLE_ENUMERATION }
            }
            steps {
                bat '''
                    "%WORKSPACE%\\.venv-logix-designer\\Scripts\\python.exe" "%WORKSPACE%\\python\\smoke\\logix_designer_executables.py" --project "%WORKSPACE%\\%LOGIX_DESIGNER_PROJECT%" --output "%WORKSPACE%\\python\\artifacts\\logix-designer-executables.json" --timeout-seconds 600 --enumerate-executables
                '''
            }
        }

        stage('Python Logix Designer Project Inventory') {
            options {
                timeout(time: 12, unit: 'MINUTES')
            }
            when {
                expression { params.RUN_PYTHON_LOGIX_DESIGNER_PROJECT_INVENTORY }
            }
            steps {
                bat '''
                    "%WORKSPACE%\\.venv-logix-designer\\Scripts\\python.exe" "%WORKSPACE%\\python\\smoke\\logix_designer_executables.py" --project "%WORKSPACE%\\%LOGIX_DESIGNER_PROJECT%" --output "%WORKSPACE%\\python\\artifacts\\logix-designer-project-inventory.json" --timeout-seconds 600 --project-inventory
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: '2-cicd-config/1-ci-teststage/2-ci-unittestscript/**/bin/Release/**/*,python/artifacts/*.json',
                             allowEmptyArchive: true,
                             fingerprint: true
        }

        success {
            echo 'Jenkins smoke pipeline completed successfully.'
        }

        failure {
            echo 'Jenkins smoke pipeline failed. Review the first failing stage.'
        }
    }
}
